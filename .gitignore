/vendor/
*.log
.DS_Store
.env
config/db.local.php

# Caches e artefatos de build das ferramentas Python (tools/)
tools/.cache/
__pycache__/
*.pyc
tools/.venv-rembg/
tools/.venvs/

# Cinemáticas — artefatos regeneráveis. Versiona-se a FONTE (keyframes/, mp3,
# manifest) e o vídeo SERVIDO (public/video/cinematics/). O resto é derivado:
docs/cinematics/*/frames/
docs/cinematics/*/narracao-raw.wav
docs/cinematics/*/*.mp4
# Nova plataforma Laravel em /platform
/platform/.env
/platform/vendor/
/platform/.phpunit.result.cache
/platform/storage/logs/*.log
/platform/storage/framework/cache/*
/platform/storage/framework/sessions/*
/platform/storage/framework/views/*
/platform/bootstrap/cache/*.php
