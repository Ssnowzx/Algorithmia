# ── Telegram <-> Claude Code bridge ─────────────────────────────────────────
# Copie para `.env` (cp .env.example .env) e preencha. O .env NAO vai pro git.

# OBRIGATORIO — token do bot, gerado pelo @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# OBRIGATORIO depois do 1o teste — so estes chat ids podem te comandar o bot.
# Deixe vazio na 1a vez: o bot entra em "modo descoberta" e te diz o seu id.
# Varios? separe por virgula: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_ID=

# OPCIONAL — pasta do projeto inicial onde o Claude opera (pode trocar pelo chat).
# Default: a raiz deste repositorio (dois niveis acima desta pasta).
# CLAUDE_PROJECT_DIR=/Users/snows/AntiGravity/TrabalhoWillen2

# OPCIONAL — pastas-raiz onde /projetos descobre os projetos (separadas por virgula).
# Default: a pasta-mae do projeto inicial.
# PROJECTS_ROOTS=/Users/snows/AntiGravity,/Users/snows/Cursor

# OPCIONAL — caminho do CLI claude (se nao estiver no PATH).
# CLAUDE_BIN=/opt/homebrew/bin/claude

# OPCIONAL — modo de permissao do Claude headless:
#   acceptEdits      (default) edita arquivos sozinho; nega bash perigoso nao-permitido
#   bypassPermissions  autonomia TOTAL (roda qualquer comando). As deny-rules
#                      globais (rm -rf, sudo...) ainda bloqueiam. Use com cuidado.
#   default            pede permissao — NAO recomendado headless (pode travar)
# CLAUDE_PERMISSION_MODE=acceptEdits

# OPCIONAL — modelo (vazio = default do CLI).
# CLAUDE_MODEL=

# OPCIONAL — timeout por execucao, em ms (default 600000 = 10 min).
# CLAUDE_TIMEOUT_MS=600000
