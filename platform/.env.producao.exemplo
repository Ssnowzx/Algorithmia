# Modelo do ambiente de produção. Copie para `.env.producao` no servidor e
# preencha. O arquivo real NUNCA entra no git.
#
#   cp .env.producao.exemplo .env.producao
#   docker compose -f compose.prod.yml run --rm app php artisan key:generate --show
#
APP_NAME=Algorithmia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://algorithmia.tars.art.br

# ⚠️ O `APP_URL` acima precisa estar CERTO antes do primeiro `bin/deploy.sh`.
#
# A migration que liga o multitenant cria o tenant padrão com o host tirado dele. Se o
# APP_URL disser `localhost` no dia do corte, o domínio real não estará em
# `tenant_dominios`, o `ResolverTenant` não achará instituição nenhuma, e o site
# responderá 404 — com o banco cheio e o healthcheck verde.
#
# Ligado por padrão. Desligar não é opção de conveniência: sem contexto de tenant, o
# `DEFAULT` de `tenant_id` devolve NULL, o `NOT NULL` derruba toda inserção, e as policies
# escondem toda leitura. Existe para o caminho inverso — um banco anterior à Etapa C.2.
TENANCY_ATIVA=true

# O host do console do operador — a tela que lista, liga e desliga as instituições.
#
# ⚠️ VAZIO por padrão, e com ele vazio as rotas do console NEM SÃO REGISTRADAS: `/console`
# responde 404 em todo domínio. Um middleware que checasse o host seria uma linha que
# alguém pode remover; uma rota que não existe não tem como ser alcançada.
#
# Se preencher: use um host DEDICADO, que NÃO esteja em `tenant_dominios` (o console não é
# uma instituição), com o mesmo certificado, e de preferência atrás de um `allow`/`deny`
# por IP no nginx. Crie o operador com:
#
#   php artisan algorithmia:operador:novo "Nome" email@exemplo.com
#
# Não há conta padrão, nem seed com senha conhecida. Ver RUNBOOK §11.
CONSOLE_HOST=

# Um stack trace exibido a um aluno é um caminho de arquivo entregue a um atacante.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Uma linha por evento, em JSON, com `request_id`, `usuario_id`, `ip` e `rota` no
# contexto. Sem isto o log é texto corrido, e investigar um incidente é ler as linhas
# de trinta jogadores simultâneos intercaladas, sem nada que as separe.
# O mesmo `request_id` sai no cabeçalho X-Request-Id e na tabela `auditoria`.
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=algorithmia

# A APLICAÇÃO conecta com este papel. Ele não é dono de nada, não é superusuário e não
# tem BYPASSRLS — é o que o torna sujeito às policies de Row-Level Security. A migration
# `create_papel_de_execucao` o cria, com a senha abaixo.
DB_USERNAME=algorithmia_app
DB_PASSWORD=

# O DONO do banco: roda migrations, cria o papel acima, importa o legado. É o
# `POSTGRES_USER` do `.env.producao.postgres`, e a senha tem de ser a mesma.
#
# Ele ignora o RLS por três razões independentes — é superusuário, tem `rolbypassrls` e
# é dono das tabelas. A aplicação NUNCA deve conectar com ele.
DB_DONO_USERNAME=algorithmia
DB_DONO_PASSWORD=

# Quem está na frente do nginx do port, terminando o TLS. Durante a coexistência é o
# `httpd` do jogo antigo (normalmente 127.0.0.1 ou o gateway do Docker).
#
# VAZIO por padrão, e assim deve ficar se o nginx atender direto na 80/443: confiar
# num proxy inexistente deixa qualquer cliente forjar X-Forwarded-Proto.
#
# Aceita uma lista separada por vírgula, ou `*`. Descubra o IP com:
#   docker compose -f compose.prod.yml logs web | head   (o $remote_addr das requisições)
TRUSTED_PROXIES=

# O estado da batalha carrega o gabarito de todos os desafios: não cabe num cookie,
# e mandá-lo ao cliente entregaria as respostas.
#
# SESSION_SECURE_COOKIE=true exige que o Laravel SAIBA que a conexão é HTTPS. Atrás
# de proxy, isso depende de TRUSTED_PROXIES acima. Sem ele, o cookie nunca é enviado
# e o jogador cai na tela de login para sempre.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Só para o comando `algorithmia:importar`, no dia do corte. Somente leitura.
#
# PREFIRA O SOCKET. Num host compartilhado, abrir o MySQL em TCP para a faixa 172.x
# o entrega aos containers de todos os outros tenants da máquina. Com o socket
# montado no container (ver RUNBOOK §2), não é preciso abrir porta nenhuma.
#   LEGADO_DB_SOCKET=/var/run/mysqld/mysqld.sock
# Vazio = usa TCP (LEGADO_DB_HOST/PORT abaixo).
LEGADO_DB_SOCKET=

LEGADO_DB_HOST=
LEGADO_DB_PORT=3306
LEGADO_DB_DATABASE=algorithmia
LEGADO_DB_USERNAME=
LEGADO_DB_PASSWORD=
