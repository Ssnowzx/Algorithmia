# Modelo do ambiente de produção. Copie para `.env.producao` no servidor e
# preencha. O arquivo real NUNCA entra no git.
#
#   cp .env.producao.exemplo .env.producao
#   docker compose -f compose.prod.yml run --rm app php artisan key:generate --show
#
APP_NAME=Algorithmia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://algorithmia.tars.art.br

# Um stack trace exibido a um aluno é um caminho de arquivo entregue a um atacante.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=algorithmia
DB_USERNAME=algorithmia
DB_PASSWORD=

# O estado da batalha carrega o gabarito de todos os desafios: não cabe num cookie,
# e mandá-lo ao cliente entregaria as respostas.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Só para o comando `algorithmia:importar`, no dia do corte. Somente leitura.
LEGADO_DB_HOST=
LEGADO_DB_PORT=3306
LEGADO_DB_DATABASE=algorithmia
LEGADO_DB_USERNAME=
LEGADO_DB_PASSWORD=
