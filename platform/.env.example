APP_NAME="Algorithmia Platform"
APP_ENV=local
APP_KEY=base64:CHANGE_ME
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

TENANCY_PLATFORM_HOSTS=localhost,127.0.0.1,algorithmia.test
TENANCY_TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=debug

AUTH_GUARD=web
AUTH_MODEL=App\Domain\Identity\Models\User

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=algorithmia_platform
DB_USERNAME=algorithmia_runtime
DB_PASSWORD=change_me_runtime

MIGRATOR_DB_HOST=postgres
MIGRATOR_DB_PORT=5432
MIGRATOR_DB_DATABASE=algorithmia_platform
MIGRATOR_DB_USERNAME=algorithmia
MIGRATOR_DB_PASSWORD=change_me_migrator

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@algorithmia.local
MAIL_FROM_NAME="${APP_NAME}"
