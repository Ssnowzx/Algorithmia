# ============================================================
#  Algorithmia — configuração Apache
# ============================================================
# IMPORTANTE: o ideal é apontar o document root para uma pasta public/.
# Enquanto o root for a raiz do projeto, estas regras impedem que código,
# dumps SQL e metadados sejam baixados/executados pela web.
#
# (Com `php -S localhost:8001` este arquivo é ignorado — em dev acesse
#  index.php?url=... normalmente. Sob Nginx, replique estas regras lá.)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Bloqueia diretórios sensíveis (código, dumps, metadados de agentes).
    #
    # `tests`, `bin` e `vendor` entram porque o DocumentRoot é a raiz do projeto:
    # sem eles, um GET /tests/bootstrap.php seria EXECUTADO pelo mod_php. Ele força
    # DB_NAME=algorithmia_test e exige o vendor/autoload.php, que produção não tem —
    # o resultado é um fatal error que imprime o caminho absoluto dos arquivos.
    RewriteRule ^(database|config|app|docs|openspec|tools|tests|bin|vendor|\.git|\.cursor|\.codex|\.claude)(/|$) - [F,L]

    # 2. Front controller: tudo que não for arquivo/pasta real vai pro index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# 3. Bloqueia extensões que nunca devem ser servidas como estático.
<FilesMatch "\.(sql|md|sh|py|ya?ml|mdc|log)$">
    Require all denied
</FilesMatch>

# 4. Protege dotfiles e overrides locais de config.
<FilesMatch "(^\.|\.local\.php$)">
    Require all denied
</FilesMatch>

# 4b. Metadados de build na raiz. Nomeados um a um, e não pela extensão: bloquear
#     `.json` inteiro quebraria qualquer asset futuro servido como JSON.
<FilesMatch "^(composer\.(json|lock)|phpunit\.xml|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# 5. Garante o MIME do WebP (hosts antigos servem como octet-stream, o que
#    impede o uso como background-image em CSS).
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# 6. Cache de longa duração para assets (versionados via ?v=filemtime).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png        "access plus 1 year"
    ExpiresByType image/webp       "access plus 1 year"
    ExpiresByType image/jpeg       "access plus 1 year"
    ExpiresByType image/svg+xml    "access plus 1 month"
    ExpiresByType text/css         "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2       "access plus 1 year"
</IfModule>

# 6. Compressão de texto.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
